---
import Base from "../layouts/Base.astro";
import CopyButton from "../components/CopyButton.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { CONTACT } from "../consts";

const mailto = `mailto:${CONTACT.email}`;
// For visitors without an email app set up, where mailto: links do nothing.
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(CONTACT.email)}`;
// Opens a WhatsApp chat (app or web) with a first message already typed.
const whatsapp = `https://wa.me/${CONTACT.whatsapp.number}?text=${encodeURIComponent(
  "Hi Rokon, I found your portfolio and would like to talk.",
)}`;

// Each topic opens the visitor's email app with the subject already filled in.
const topics = [
  { label: "A backend role", subject: "Backend role" },
  { label: "A freelance project", subject: "Freelance project" },
  { label: "Just saying hi", subject: "Hello" },
];

const checklist = [
  "What you're building and the problem it solves",
  "Whether it's a role or a project, and your timeline",
  "The current stack, if there is one",
  "A rough budget, for freelance work",
];

const channels = [
  { name: "WhatsApp", href: whatsapp, handle: CONTACT.whatsapp.display, icon: "whatsapp" },
  // Short handles: the card title already names the site, and three cards share a row.
  { name: "GitHub", href: CONTACT.github, handle: `@${CONTACT.github.split("/").pop()}`, icon: "github" },
  { name: "LinkedIn", href: CONTACT.linkedin, handle: CONTACT.linkedin.replace("https://www.linkedin.com/", ""), icon: "linkedin" },
];

const whatsappIcon =
  "M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z";

const services = [
  {
    title: "APIs",
    text: "REST APIs in FastAPI, Django and Flask, with JWT authentication, validation and clear docs.",
  },
  {
    title: "Data pipelines",
    text: "Collecting supplier XML/JSON data, then cleaning, normalizing and loading it where it's needed.",
  },
  {
    title: "Database performance",
    text: "Schema design, indexing and query tuning that keep MySQL and PostgreSQL fast and consistent.",
  },
  {
    title: "API integrations",
    text: "Connecting third-party APIs, such as hotel suppliers, and building business APIs on top of them.",
  },
];
---

<Base
  title="Contact"
  description="How to get in touch with Rokunuzzaman Rokon about backend roles or freelance work."
  width="full"
>
  <section class="hero" aria-labelledby="contact-title">
    <div class="container hero-grid">
      <div class="hero-main">
        <p class="hero-status">
          <span class="status-dot" aria-hidden="true"></span>
          Open to roles &amp; freelance work
        </p>
        <h1 class="hero-title" id="contact-title">Let's talk.</h1>
        <p class="hero-tagline">
          I'm open to backend roles and freelance work on APIs, data pipelines and database
          performance. Email or WhatsApp is the fastest way to reach me, and I reply within 24 hours.
        </p>
        <div class="hero-actions">
          <!-- Goes to the email section below (address, copy, Gmail), not straight to a mail app. -->
          <a class="button button--primary button--down" href="#email">
            Email me
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
          </a>
          <a class="button button--secondary button--whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={whatsappIcon}></path></svg>
            WhatsApp
          </a>
          <a class="button button--secondary button--download" href={CONTACT.cv} download>
            Download CV
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          </a>
        </div>
      </div>

      <aside class="spec-card" aria-label="Quick facts">
        <p class="spec-card-title">Quick facts</p>
        <dl>
          <div>
            <dt>Based in</dt>
            <dd>Dhaka, Bangladesh</dd>
          </div>
          <div>
            <dt>Local time</dt>
            <!-- The script below fills in the current time in Dhaka. -->
            <dd id="local-time">UTC+6</dd>
          </div>
          <div>
            <dt>Replies</dt>
            <dd>Within 24 hours</dd>
          </div>
          <div>
            <dt>Open to</dt>
            <dd>Full-time roles, freelance &amp; contract work</dd>
          </div>
          <div>
            <dt>Best via</dt>
            <dd>Email or WhatsApp</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="write-heading">
    <div class="container">
      <SectionHeading id="write-heading" index="01" kicker="Get in touch" title="Start a conversation" />

      <div class="contact-panel" id="email" data-reveal>
        <div>
          <p class="eyebrow">Email</p>
          <div class="contact-email-row">
            <a class="contact-email contact-email--large" href={mailto}>{CONTACT.email}</a>
            <span class="contact-email-tools">
              <CopyButton text={CONTACT.email} label="email address" />
              <a class="mini-button" href={gmail} target="_blank" rel="noopener noreferrer">
                Open in Gmail <span aria-hidden="true">↗</span>
              </a>
            </span>
          </div>

          <p class="eyebrow" id="topics-label">Or start with a topic</p>
          <ul class="topic-list" aria-labelledby="topics-label">
            {
              topics.map(({ label, subject }) => (
                <li>
                  <a href={`${mailto}?subject=${encodeURIComponent(subject)}`}>
                    {label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="contact-panel-aside">
          <h3 class="eyebrow">Helpful to include</h3>
          <ul class="checklist">
            {checklist.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <ul class="channel-grid">
        {
          channels.map(({ name, href, handle, icon }) => (
            <li class="channel-card" data-reveal>
              <span class={`channel-icon channel-icon--${icon}`} aria-hidden="true">
                {icon === "whatsapp" ? (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={whatsappIcon}></path></svg>
                ) : icon === "github" ? (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
                ) : (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 4.89v4.85zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
                )}
              </span>
              <div>
                <h3>
                  {icon === "whatsapp" ? (
                    <a href={href} target="_blank" rel="noopener noreferrer">{name}</a>
                  ) : (
                    <a href={href} rel="me noopener">{name}</a>
                  )}
                </h3>
                <p>{handle}</p>
              </div>
              <span class="channel-arrow" aria-hidden="true">↗</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="help-heading">
    <div class="container">
      <SectionHeading
        id="help-heading"
        index="02"
        kicker="Services"
        title="How I can help"
        link={{ href: "/projects/", label: "See projects" }}
      />
      <ol class="feature-grid">
        {
          services.map(({ title, text }, i) => (
            <li class="feature" data-reveal>
              <span class="feature-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<script>
  // Local time in Dhaka, refreshed at the start of every minute.
  const localTime = document.querySelector<HTMLElement>("#local-time");
  if (localTime) {
    const format = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Dhaka",
      hour: "2-digit",
      minute: "2-digit",
    });
    const tick = () => {
      localTime.textContent = `${format.format(new Date())} (UTC+6)`;
      setTimeout(tick, 60_000 - (Date.now() % 60_000));
    };
    tick();
  }
</script>
