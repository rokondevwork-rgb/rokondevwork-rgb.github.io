---
import Base from "../layouts/Base.astro";
import CopyButton from "../components/CopyButton.astro";
import Icon from "../components/Icon.astro";
import Terminal from "../components/Terminal.astro";
import { CONTACT } from "../consts";

const mailto = `mailto:${CONTACT.email}`;
// For visitors without an email app set up, where mailto: links do nothing.
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(CONTACT.email)}`;
// Opens a WhatsApp chat (app or web) with a first message already typed.
const whatsapp = `https://wa.me/${CONTACT.whatsapp.number}?text=${encodeURIComponent(
  "Hi Rokon, I found your portfolio and would like to talk.",
)}`;

// Each topic opens a new Gmail message in a new tab, addressed to me with the subject already filled in.
const topics = [
  { label: "A backend role", subject: "Backend role" },
  { label: "A freelance project", subject: "Freelance project" },
  { label: "Just saying hi", subject: "Hello" },
];

const checklist = [
  "What you're building and the problem it solves",
  "Whether it's a role or a project, and your timeline",
  "The current stack, if there is one",
  "A rough budget, for freelance work",
];
---

<Base
  title="Contact"
  sheet="Sheet B8 · Service elevator"
  description="How to get in touch with Rokunuzzaman Rokon about backend roles or freelance work."
>
  <div class="sheet">
    <div class="sheet-title">
      <h1 class="sign">Let’s talk</h1>
      <p class="serif">
        <span class="reveal">Open to backend roles and freelance work on APIs, data pipelines and database performance.</span>{" "}
        <em class="reveal" style="--fill: var(--signal-text)">I reply within 24 hours.</em>
      </p>
    </div>

    <div class="contact-wrap">
      <div class="contact-main">
        <div style="display: grid; gap: 12px" id="email">
          <span class="mono pencil">Email · fastest</span>
          <a class="big-email" href={mailto}>{CONTACT.email}</a>
          <div style="display: flex; flex-wrap: wrap; gap: 8px">
            <CopyButton text={CONTACT.email} label="email address" />
            <a class="copy-button" href={gmail} target="_blank" rel="noopener noreferrer" style="text-decoration: none">Open in Gmail <Icon name="external" size={12} /></a>
          </div>
        </div>

        <div style="display: grid; gap: 10px">
          <h2 class="mono pencil" id="topics">Or start with a topic</h2>
          <ul class="links-grid" role="list" aria-labelledby="topics">
            {
              topics.map(({ label, subject }) => (
                <li>
                  <a href={`${gmail}&su=${encodeURIComponent(subject)}`} target="_blank" rel="noopener noreferrer">
                    {label}
                    <span class="ico mono">Gmail <Icon name="external" size={12} /></span>
                  </a>
                </li>
              ))
            }
            <li><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp · {CONTACT.whatsapp.display} <Icon name="external" size={12} /></a></li>
          </ul>
        </div>

        <ul class="links-grid" role="list" aria-label="Elsewhere">
          <li><a href={CONTACT.github} rel="me noopener"><span class="mono">GitHub</span><span class="ico" translate="no">{CONTACT.github.split("/").pop()} <Icon name="external" size={12} /></span></a></li>
          <li><a href={CONTACT.linkedin} rel="me noopener"><span class="mono">LinkedIn</span><span class="ico" translate="no">rokon-raz <Icon name="external" size={12} /></span></a></li>
          <li><a href={CONTACT.cv} download><span class="mono">CV</span><span class="ico">Download PDF <Icon name="download" size={12} /></span></a></li>
          <li><span style="display: flex; justify-content: space-between; min-height: 52px; padding: 12px; font-size: 1rem"><span class="mono">Local time</span><span id="local-time">Dhaka · UTC+6</span></span></li>
        </ul>

        <div class="title-block">
          <div class="title-block-head mono"><span>Helpful to include</span></div>
          <ul class="results" role="list" style="border: 0">
            {checklist.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <Terminal />
    </div>
  </div>
</Base>

<script>
  // The current time in Dhaka, so visitors know when a reply is likely.
  const el = document.querySelector<HTMLElement>("#local-time");
  if (el) {
    const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Dhaka" });
    const tick = () => (el.textContent = `Dhaka · ${fmt.format(new Date())}`);
    tick();
    setInterval(tick, 30_000);
  }
</script>
