---
import Base from "../layouts/Base.astro";
import AboutIntro from "../components/AboutIntro.astro";
import CoreSample from "../components/CoreSample.astro";
import Foundations from "../components/Foundations.astro";
import Icon from "../components/Icon.astro";
import Level from "../components/Level.astro";
import Trench from "../components/Trench.astro";
import { FLOORS } from "../lib/data";

const floor = (code: string) => FLOORS.find((f) => f.code === code)!;
---

<Base
  snap
  title="About"
  sheet="Sheet B1 · Service entrance"
  description="About Rokunuzzaman Rokon, a Python backend developer in Dhaka building APIs, hotel content platforms, and data pipelines."
>
  <div class="sheet">
    <div class="sheet-title">
      <h1 class="sign">About</h1>
      <p class="serif"><span class="reveal">A Python backend engineer in Dhaka,</span> <em class="reveal" style="--fill: var(--h-indigo)">building the parts nobody sees.</em></p>
    </div>
    <AboutIntro eager />
  </div>

  <Level floor={{ ...floor("B6"), id: "journey" }} title="Core sample" sub="Experience: four years of strata, newest at the drill head." band="ochre" tone="var(--h-olive)">
    <CoreSample />
  </Level>

  <Level floor={{ ...floor("B3"), id: "stack" }} title="Utility trench" sub="Skills, as pipes. Tap one to see what it connects to and where I used it." band="earth" tone="var(--h-clay)">
    <Trench />
  </Level>

  <Level floor={{ ...floor("B7"), id: "principles" }} title="Foundations" sub="How I work. <em>Three piles I drive before I build anything on top.</em>" band="none" bedrock tone="var(--chalk)" numTone="var(--graphite)" class="lvl--piles">
    <Foundations />
    <a class="out-link" href="/contact/">Have a Backend Problem? Get in Touch <Icon name="right" /></a>
  </Level>
</Base>
