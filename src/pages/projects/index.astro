---
import Base from "../../layouts/Base.astro";
import VaultPlan from "../../components/VaultPlan.astro";
import { PROJECT_FILTERS } from "../../consts";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<Base
  title="Projects"
  sheet="Sheet B4 · Vaults · plan view"
  description="Backend projects by Rokunuzzaman Rokon: hotel content APIs, booking systems, data ingestion, and full-stack apps."
>
  <div class="sheet sheet--wide" style="--tone: var(--h-mulberry)">
    <div class="sheet-title">
      <h1 class="sign">Vaults</h1>
      <p class="serif">
        <span class="reveal">{projects.length} projects, seen from above.</span>{" "}
        <em class="reveal" style="--fill: var(--h-mulberry)">Hotel tech gets the big rooms.</em>
      </p>
    </div>
    <VaultPlan projects={projects} filters={["All", ...PROJECT_FILTERS]} headingLevel={2} />
  </div>
</Base>
