---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<Base
  title="Projects"
  description="Selected backend projects by Rokunuzzaman Rokon: hotel content APIs, booking systems, data ingestion, and full-stack apps."
>
  <h1>Projects</h1>
  <p class="lead">Selected work: APIs, hotel content platforms, and data-driven applications.</p>

  {
    projects.length > 0 ? (
      <ul class="project-list">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    ) : (
      <p>No projects yet.</p>
    )
  }
</Base>
