---
/**
 * A case study as an excavation sheet: the project is dug in layers, from the problem at the
 * surface down to the outcomes at bedrock. Each layer appears only when its frontmatter is set;
 * the Markdown body is the field record in the middle.
 */
import { render, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { getProjects } from "../../lib/content";
import { getProjectPictures } from "../../lib/projectImages";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    // The first and last projects link round to each other.
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, prev, next } = Astro.props;
const { title, summary, stack, role, domain, link, results, imageIsConcept, problem, constraints, architecture, dataModel } = project.data;

// Pictures come from src/assets/projects/<slug>/ (hero.png, 1.png, 2.png, …). See lib/projectImages.ts.
const { hero, gallery } = getProjectPictures(project);
const pictures = [hero, ...gallery].filter((p) => p !== undefined);
// A large webp of each picture for the viewer; without JS the links open it directly.
const large = await Promise.all(
  pictures.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: "webp" })),
);
const offset = hero ? 1 : 0;
const exhibitNo = (i: number) => String(i + 1).padStart(2, "0");
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
const vault = (p: CollectionEntry<"projects">) => `V-${String(p.data.order).padStart(2, "0")}`;
const tones = ["var(--h-teal)", "var(--h-mulberry)", "var(--h-clay)", "var(--h-indigo)", "var(--h-olive)"];
const tone = tones[(project.data.order - 1) % tones.length];

// Layers in digging order; each is numbered only if it is present.
const layers = [
  problem && "surface",
  constraints?.length && "topsoil",
  architecture?.length && "structure",
  dataModel?.length && "foundations",
  hasBody && "record",
  results?.length && "bedrock",
].filter(Boolean) as string[];
const num = (name: string) => String(layers.indexOf(name) + 1).padStart(2, "0");
const layerTones = ["var(--h-teal)", "var(--h-clay)", "var(--signal-text)", "var(--h-olive)", "var(--h-indigo)", "var(--h-mulberry)"];
const layerTone = (name: string) => layerTones[layers.indexOf(name) % layerTones.length];
---

<Base title={title} description={summary} sheet={`Excavation sheet · ${vault(project)}`}>
  <div class="sheet" style={`--tone: ${tone}`}>
    <a class="mono ico" href="/projects/" style="color: var(--ink); text-decoration: none; min-height: 44px; margin-bottom: 24px"><Icon name="left" /> Back to the Vaults</a>

    <div class="sheet-hero">
      <div class="sheet-title" style="margin: 0">
        <h1 class="sign">{title}</h1>
        <span class="mono pencil">{vault(project)}{domain && ` · ${domain}`}</span>
        <p class="serif"><span class="reveal">{summary}</span></p>
      </div>
      <div class="title-block">
        <div class="title-block-head mono"><span>Title block</span><span class="pencil">Sheet {vault(project)}</span></div>
        <dl>
          {role && <div><dt class="mono">Role</dt><dd>{role}</dd></div>}
          {domain && <div><dt class="mono">Domain</dt><dd>{domain}</dd></div>}
          {link && <div><dt class="mono">Link</dt><dd><a href={link} rel="noopener">{new URL(link).hostname}</a></dd></div>}
          <div style="grid-column: 1 / -1"><dt class="mono">Stack</dt><dd class="mono" style="color: var(--teal); font-size: 0.75rem">{stack.join(" · ")}</dd></div>
        </dl>
      </div>
    </div>

    {
      hero && (
        <figure class="exhibit">
          <a class="exhibit-frame" href={large[0].src} data-lightbox="0" data-label={`Exhibit 01 · ${title}`}>
            <Image src={hero.src} alt={hero.alt} widths={[640, 1000, 1400, 1800]} sizes="(min-width: 1200px) 1180px, 100vw" loading="eager" fetchpriority="high" />
          </a>
          <figcaption class="mono">
            <span>Exhibit 01 · {title}</span>
            {imageIsConcept && <span class="pencil">Concept screen with sample data</span>}
          </figcaption>
        </figure>
      )
    }

    {
      gallery.length > 0 && (
        <section class="exhibit-set" aria-labelledby="exhibit-set-title">
          <div class="exhibit-set-head mono">
            <h2 id="exhibit-set-title">More exhibits</h2>
            <span class="pencil">{gallery.length} {gallery.length === 1 ? "screen" : "screens"} · select to enlarge</span>
          </div>
          <ul class="exhibit-grid" role="list" data-count={Math.min(gallery.length, 3)}>
            {gallery.map((p, i) => (
              <li>
                <figure>
                  <a class="exhibit-thumb" href={large[offset + i].src} data-lightbox={offset + i} data-label={`Exhibit ${exhibitNo(offset + i)}${p.caption ? ` · ${p.caption}` : ""}`}>
                    <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 1200px) 380px, (min-width: 700px) 50vw, 100vw" loading="lazy" />
                  </a>
                  <figcaption class="mono">
                    <span>Exhibit {exhibitNo(offset + i)}</span>
                    {p.caption && <span class="pencil">{p.caption}</span>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      problem && (
        <section class="layer" aria-labelledby="layer-surface" style={`--tone: ${layerTone("surface")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("surface")}</span><h2 id="layer-surface" class="mono">Surface</h2><span class="mono pencil">The problem</span></div>
          <div class="layer-body"><p class="serif"><span class="reveal">{problem}</span></p></div>
        </section>
      )
    }

    {
      constraints && constraints.length > 0 && (
        <section class="layer" aria-labelledby="layer-topsoil" style={`--tone: ${layerTone("topsoil")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("topsoil")}</span><h2 id="layer-topsoil" class="mono">Topsoil</h2><span class="mono pencil">Constraints</span></div>
          <div class="layer-body">
            <ul class="constraint-grid" role="list">
              {constraints.map((c) => (
                <li>
                  <span class="mono pencil">{c.label}</span>
                  <span class="sign">{c.value}</span>
                  <span>{c.note}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      architecture && architecture.length > 0 && (
        <section class="layer" aria-labelledby="layer-structure" style={`--tone: ${layerTone("structure")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("structure")}</span><h2 id="layer-structure" class="mono">Structure</h2><span class="mono pencil">Request path</span></div>
          <div class="layer-body">
            <ol class="chain mono">
              {architecture.map((n) => (
                <li class={`is-${n.kind}`}><span>{n.name}</span></li>
              ))}
            </ol>
            <p class="mono pencil">Vermilion: the request moving · teal: data at rest</p>
          </div>
        </section>
      )
    }

    {
      dataModel && dataModel.length > 0 && (
        <section class="layer" aria-labelledby="layer-foundations" style={`--tone: ${layerTone("foundations")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("foundations")}</span><h2 id="layer-foundations" class="mono">Foundations</h2><span class="mono pencil">Data model</span></div>
          <div class="layer-body">
            <ul class="tables mono" role="list">
              {dataModel.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </section>
      )
    }

    {
      hasBody && (
        <section class="layer" aria-labelledby="layer-record" style={`--tone: ${layerTone("record")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("record")}</span><h2 id="layer-record" class="mono">Field record</h2><span class="mono pencil">What I built</span></div>
          <div class="layer-body prose">
            <Content />
          </div>
        </section>
      )
    }

    {
      results && results.length > 0 && (
        <section class="layer" aria-labelledby="layer-bedrock" style={`--tone: ${layerTone("bedrock")}`}>
          <div class="layer-label"><span class="sign" aria-hidden="true">{num("bedrock")}</span><h2 id="layer-bedrock" class="mono">Bedrock</h2><span class="mono pencil">Outcomes</span></div>
          <div class="layer-body">
            <ul class="results" role="list">
              {results.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        </section>
      )
    }

    {
      !hasBody && import.meta.env.DEV && (
        <p class="results">Case study coming soon. Add it in <code>src/content/projects/{project.id}.md</code>. (Only shown in dev.)</p>
      )
    }
  </div>

  {
    pictures.length > 0 && (
      <dialog class="lightbox" data-lightbox-dialog aria-label={`${title} pictures`}>
        <figure>
          <img data-lightbox-img alt="" decoding="async" />
          <figcaption class="mono">
            <span data-lightbox-label></span>
            <span class="pencil" data-lightbox-count></span>
          </figcaption>
        </figure>
        <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Close picture"><Icon name="close" size={16} /></button>
        <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-step="-1" aria-label="Previous picture"><Icon name="left" size={16} /></button>
        <button type="button" class="lightbox-btn lightbox-next" data-lightbox-step="1" aria-label="Next picture"><Icon name="right" size={16} /></button>
      </dialog>
    )
  }

  <nav class="sheet-nav mono" aria-label="Other vaults" style="border-bottom: 1px solid var(--pencil)">
    <a href={`/projects/${prev.id}/`}><Icon name="left" /> {vault(prev)} {prev.data.title}</a>
    <a href={`/projects/${next.id}/`}>{vault(next)} {next.data.title} <Icon name="right" /></a>
  </nav>
</Base>

<script>
  /* Picture viewer: every [data-lightbox] link opens in one dialog; arrows, swipe and Esc work. */
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")];
  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const label = dialog.querySelector<HTMLElement>("[data-lightbox-label]")!;
    const count = dialog.querySelector<HTMLElement>("[data-lightbox-count]")!;
    const steps = dialog.querySelectorAll<HTMLButtonElement>("[data-lightbox-step]");
    let current = 0;
    let opener: HTMLElement | null = null;

    steps.forEach((b) => (b.hidden = links.length < 2));

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.querySelector("img")?.alt ?? "";
      label.textContent = link.dataset.label ?? "";
      count.textContent = links.length > 1 ? `${current + 1} / ${links.length}` : "";
    };

    links.forEach((link, i) =>
      link.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );

    steps.forEach((b) => b.addEventListener("click", () => show(current + Number(b.dataset.lightboxStep))));
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    // A click on the dark backdrop (the dialog itself, not its picture or buttons) closes it.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(current + 1);
      if (e.key === "ArrowLeft") show(current - 1);
    });
    let touchX: number | null = null;
    dialog.addEventListener("touchstart", (e) => (touchX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      if (touchX === null || links.length < 2) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      touchX = null;
    });
    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
      opener?.focus();
    });
  }
</script>
