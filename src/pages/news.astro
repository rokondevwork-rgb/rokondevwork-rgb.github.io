---
import Base from "../layouts/Base.astro";
import { timeAgo } from "../lib/format";

interface Story {
  id: string;
  title: string;
  /** The article; for Ask HN and similar posts, the discussion itself. */
  url: string;
  domain: string;
  hnUrl: string;
  author: string;
  points: number;
  comments: number;
  /** Unix seconds. */
  time: number;
}

interface News {
  /** When the stories were fetched, in Unix seconds. */
  updated: number;
  minPoints: number;
  stories: Story[];
}

// Written by scripts/fetch_hn_ai_news.py (`npm run news`), which the deploy workflow runs every
// 6 hours before building. A glob rather than an import, so a missing file doesn't break the build.
const files = import.meta.glob<News>("../data/news.json", { eager: true, import: "default" });
const news = files["../data/news.json"];
if (!news) console.warn("[news] src/data/news.json is missing: run `npm run news` to fetch it.");
// Newest first, so the list reads "1 h ago", "2 h ago", ...
const stories = (news?.stories ?? []).toSorted((a, b) => b.time - a.time);
const fetchedAt = news?.updated ?? 0;
const iso = (seconds: number) => new Date(seconds * 1000).toISOString();
---

<Base
  title="News"
  sheet="Sheet SR · Site radio · AI news"
  description="AI news from Hacker News: the last 24 hours of upvoted AI stories, newest first, updated every 6 hours."
>
  <div class="sheet" style="--tone: var(--h-teal)">
    <div class="sheet-title">
      <h1 class="sign">Site radio</h1>
      <p class="serif"><span class="reveal">AI stories from Hacker News in the last 24 hours, newest first.</span> <em class="reveal" style="--fill: var(--h-teal)">Updated every 6 hours.</em></p>
      {
        news && (
          <p class="mono status">
            Updated&nbsp;<time datetime={iso(fetchedAt)} data-time={fetchedAt}>{timeAgo(fetchedAt, fetchedAt)}</time>&nbsp;·&nbsp;{stories.length} {stories.length === 1 ? "story" : "stories"}
          </p>
        )
      }
    </div>

    {
      stories.length > 0 ? (
        <ol class="radio" role="list">
          {stories.map((story) => (
            <li>
              <time class="mono" datetime={iso(story.time)} data-time={story.time}>
                {timeAgo(story.time, fetchedAt)}
              </time>
              <div>
                <h2>
                  <a href={story.url} target="_blank" rel="noopener noreferrer" aria-describedby="news-new-tab">
                    {story.title}
                  </a>
                </h2>
                <p class="radio-meta mono">
                  <span>{story.domain}</span>
                  <span>{story.points} points</span>
                  <span>
                    <a href={story.hnUrl} target="_blank" rel="noopener noreferrer" aria-describedby="news-new-tab">
                      {story.comments} {story.comments === 1 ? "comment" : "comments"}
                    </a>
                  </span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="radio-note">
          {news
            ? `No AI stories with ${news.minPoints}+ points in the last 24 hours yet. Check back in a few hours.`
            : "News isn't available right now. Check back in a few hours."}
        </p>
      )
    }

    <p class="radio-note">
      Stories and points from <a href="https://news.ycombinator.com/">Hacker News</a>, via the{" "}
      <a href="https://hn.algolia.com/api">HN Search API</a>. Titles open the original article in a new tab;
      comment counts open the discussion on Hacker News.
    </p>
    <!-- Read out with every story link (aria-describedby), so screen reader users know too. -->
    <span id="news-new-tab" hidden>Opens in a new tab</span>
  </div>
</Base>

<script>
  import { timeAgo } from "../lib/format";

  // The page is built every 6 hours but read any time after: keep the "… ago" labels current.
  const now = Math.floor(Date.now() / 1000);
  for (const el of document.querySelectorAll<HTMLElement>("time[data-time]")) {
    el.textContent = timeAgo(Number(el.dataset.time), now);
  }
</script>
