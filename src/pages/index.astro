---
/**
 * The homepage is one continuous cross-section. The visitor starts on the street, follows a
 * single request line down through eight levels below grade, and rides the elevator back up
 * from the contact floor.
 */
import Base from "../layouts/Base.astro";
import AboutIntro from "../components/AboutIntro.astro";
import CopyButton from "../components/CopyButton.astro";
import CoreSample from "../components/CoreSample.astro";
import Icon from "../components/Icon.astro";
import Level from "../components/Level.astro";
import Logo from "../components/Logo.astro";
import Terminal from "../components/Terminal.astro";
import Trench from "../components/Trench.astro";
import VisitCount from "../components/VisitCount.astro";
import VaultPlan from "../components/VaultPlan.astro";
import { CONTACT, SITE } from "../consts";
import { FLOORS, MACHINES, PRINCIPLES } from "../lib/data";
import { getFeaturedProjects, getProjects } from "../lib/content";

const [L0, B1, B2, B3, B4, B5, B6, B7, B8] = FLOORS;
const featured = await getFeaturedProjects();
const projects = await getProjects();
const dig = projects.find((p) => p.data.problem) ?? featured[0];
const machineTones = ["var(--h-teal)", "var(--h-clay)", "var(--h-indigo)", "var(--h-mulberry)"];
const pileTones = ["#ece6da", "#f2b48f", "#9fd3cb"];
const whatsapp = `https://wa.me/${CONTACT.whatsapp.number}`;
const year = new Date().getFullYear();

// The roof flag is cut into this many strips; each one moves a little after the one before it.
const stripW = 2;
const flagStrips = Array.from({ length: 15 }, (_, k) => k);
---

<Base home snap>
  <!-- L0 · Street level -->
  <section class="street" id={L0.id} aria-labelledby="name" data-floor={L0.code} data-floor-name={L0.name} data-depth={L0.depth}>
    <div class="street-strip mono">
      <span>Sheet 00 · Section A–A · Below grade</span>
      <span class="wide">Drawn by MD. Rokunuzzaman Rokon · Dhaka 23.81°N 90.41°E</span>
    </div>

    <svg class="street-building" viewBox="0 0 104 214" aria-hidden="true" data-windows>
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M8 214V40H96V214M20 40V22H84V40M44 22V8H60V22"></path>
        <rect class="win" x="22" y="58" width="12" height="14"></rect>
        <rect class="win" x="46" y="58" width="12" height="14"></rect>
        <rect class="win" x="70" y="58" width="12" height="14"></rect>
        <rect class="win" x="22" y="88" width="12" height="14"></rect>
        <rect class="win" x="46" y="88" width="12" height="14"></rect>
        <rect class="win" x="70" y="88" width="12" height="14"></rect>
        <rect class="win" x="22" y="118" width="12" height="14"></rect>
        <rect class="win" x="46" y="118" width="12" height="14"></rect>
        <rect class="win" x="70" y="118" width="12" height="14"></rect>
        <rect class="win" x="22" y="148" width="12" height="14"></rect>
        <rect class="win" x="70" y="148" width="12" height="14"></rect>
        <path d="M42 214V182H62V214"></path>
      </g>
    </svg>
    <!-- Bangladesh flag on the roof. Cut into thin vertical strips that rise and fall one after
         another, so a wave runs from the pole to the free end, like cloth in the wind. -->
    <svg class="street-flag" viewBox="0 0 40 50" aria-hidden="true">
      <defs>
        <g id="bd-flag">
          <rect x="2" y="4" width="30" height="18" fill="#006a4e"></rect>
          <circle cx="15.5" cy="13" r="6" fill="#f42a41"></circle>
        </g>
        {
          flagStrips.map((k) => (
            <clipPath id={`bd-strip-${k}`}>
              <rect x={2 + k * stripW} y="-4" width={stripW + 0.35} height="34"></rect>
            </clipPath>
          ))
        }
      </defs>
      <path class="flag-pole" d="M1 3.5V50" stroke="currentColor" stroke-width="1.2"></path>
      <circle cx="1" cy="2.2" r="1.4" fill="currentColor"></circle>
      {
        flagStrips.map((k) => (
          <g clip-path={`url(#bd-strip-${k})`}>
            <g class="flag-wave" style={`--k: ${k}; --a: ${(0.35 + (k / flagStrips.length) * 2.4).toFixed(2)}px`}>
              <use href="#bd-flag"></use>
              <rect class="flag-shade" x="2" y="4" width="30" height="18"></rect>
            </g>
          </g>
        ))
      }
    </svg>
    <span class="street-callout mono" aria-hidden="true">What clients see</span>

    <div class="ground" aria-hidden="true"></div>
    <div class="ground-band hatch-earth" aria-hidden="true"></div>
    <div class="req" aria-hidden="true"></div>

    <span class="street-md mono" aria-hidden="true">MD. —</span>
    <h1 class="street-name sign" id="name">
      <span class="visually-hidden">MD. Rokunuzzaman Rokon</span>
      <span class="above d-only" aria-hidden="true">Rokunuzzaman</span>
      <span class="below buried d-only" aria-hidden="true">Rokunuzzaman</span>
      <span class="under buried d-only" aria-hidden="true">Rokon</span>
      <span class="above m-only" aria-hidden="true">Rokunuz-</span>
      <span class="below buried m-only" aria-hidden="true">Rokunuz-</span>
      <span class="under-1 buried m-only" aria-hidden="true">Zaman</span>
      <span class="under-2 buried m-only" aria-hidden="true">Rokon</span>
    </h1>

    <div class="street-voice">
      <p class="serif"><span class="reveal"><em>Most of what I build,</em> you never see.</span></p>
      <p class="mono">
        <span>{SITE.roles}</span>
        <span class="pencil">Dhaka, Bangladesh · UTC+6 · {SITE.experience}</span>
      </p>
    </div>

    <div class="survey">
      <span class="mono">Open to roles + freelance</span>
      <span class="survey-post" aria-hidden="true">
        <svg width="22" height="20" viewBox="0 0 22 20"><path d="M11 1L21 19H1z" fill="var(--signal)"></path></svg>
        <span></span>
      </span>
    </div>

    <a class="street-hint mono ico" href={`#${B1.id}`}>Follow the Request <Icon name="down" /></a>
  </section>

  <!-- B1 · About -->
  <Level floor={B1} title="Service entrance" sub="About the engineer: who’s working down here." band="earth" tone="var(--graphite)">
    <AboutIntro more />
  </Level>

  <!-- B2 · Expertise -->
  <Level floor={B2} title="Plant room" sub="Engineering expertise: the machines that keep the building running." band="gravel" tone="var(--h-teal)">
    <div class="scene" aria-label="Normalisation, with sample data: raw supplier fragments in, one clean record out" role="img">
      <div class="scene-raw" aria-hidden="true" data-drift>
        <span class="scene-label mono">Raw supplier feeds · sample</span>
        <span class="raw-line data" style="left: 4%; top: 8%; rotate: -4deg">&lt;Hotel Code="DAC0412"&gt;</span>
        <span class="raw-line data" style="left: 9%; top: 20%; rotate: -3deg">&lt;HotelName&gt;Example Grand Dhaka&lt;/HotelName&gt;</span>
        <span class="raw-line data" style="left: 40%; top: 33%; rotate: 2deg">"name": "EXAMPLE GRAND - DHAKA"</span>
        <span class="raw-line data" style="left: 30%; top: 46%; rotate: 3deg">&lt;Amenity&gt;Free WiFi&lt;/Amenity&gt;</span>
        <span class="raw-line data" style="left: 12%; top: 58%; rotate: -2deg">&lt;amenity&gt;wifi_free&lt;/amenity&gt;</span>
        <span class="raw-line data" style="left: 6%; top: 70%; rotate: -1deg">"star_rating": "4*",</span>
        <span class="raw-line data" style="left: 44%; top: 76%; rotate: 4deg">"rooms": "  120 "</span>
        <span class="raw-line data" style="left: 26%; top: 88%; rotate: 5deg">&lt;Lat&gt;23.79&lt;/Lat&gt;&lt;Lng&gt;90.40</span>
      </div>
      <span class="scene-pipe" aria-hidden="true"></span>
      <div class="scene-machine" aria-hidden="true">
        <svg viewBox="0 0 72 72"><g fill="none" stroke="currentColor" stroke-width="1.25"><circle cx="36" cy="36" r="22"></circle><circle cx="36" cy="36" r="8"></circle><path d="M36 6v8M36 58v8M6 36h8M58 36h8M15 15l6 6M51 51l6 6M15 57l6-6M51 21l6-6"></path></g></svg>
        <span class="sign" style="font-size: 1.875rem; font-weight: 800">Normaliser</span>
        <span class="mono pencil">Validate · map · dedupe</span>
      </div>
      <span class="scene-pipe scene-pipe--stored" aria-hidden="true"></span>
      <div class="scene-clean" aria-hidden="true">
        <span class="scene-label mono">One clean record</span>
        <pre class="data">{`{
  "hotel_id": "DAC0412",
  "name": "Example Grand Dhaka",
  "stars": 4,
  "geo": { "lat": 23.79, "lng": 90.40 },
  "rooms": 120,
  "amenities": ["wifi"]
}`}</pre>
      </div>
    </div>

    <ul class="machines" role="list">
      {
        MACHINES.map((m, i) => (
          <li class="machine" style={`--tone: ${machineTones[i]}`}>
            <div class="machine-plate sign" aria-hidden="true">{m.code}</div>
            <h3 class="sign">{m.name}</h3>
            <p>{m.line}</p>
            <ul class="calls mono" role="list">
              {m.calls.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Level>

  <!-- B3 · Technology ecosystem -->
  <Level floor={B3} title="Utility trench" sub="The technology ecosystem. Every tool is a pipe; what matters is what it connects to." band="earth" tone="var(--h-clay)">
    <Trench />
    <p class="mono pencil" style="margin: 20px 0 0 18px">Tap a pipe to trace it · no skill levels, only real connections</p>
  </Level>

  <!-- B4 · Featured projects -->
  <Level floor={B4} title="Vaults" sub={`Featured projects: ${featured.length} rooms, seen from above.`} band="rock" tone="var(--h-mulberry)">
    <VaultPlan projects={featured} row />
    <a class="out-link" href="/projects/">All {projects.length} Projects <Icon name="right" /></a>
  </Level>

  <!-- B5 · Case study preview -->
  {
    dig && (
      <Level floor={B5} title="Excavation sheet" sub={`Case studies are dug in five layers. Here’s ${dig.data.title}.`} band="earth" tone="var(--h-indigo)">
        <div class="dig">
          {dig.data.problem && (
            <div class="dig-row">
              <div class="dig-label mono">01 · Surface<span class="pencil">The problem</span></div>
              <p class="dig-body serif"><span class="reveal" style="--fill: var(--h-indigo)">{dig.data.problem}</span></p>
            </div>
          )}
          {dig.data.constraints && (
            <div class="dig-row hatch-gravel">
              <div class="dig-label mono">02 · Topsoil<span class="pencil">Constraints</span></div>
              <p class="dig-body mono"><span>{dig.data.constraints.map((c) => c.value).join(" · ")}</span></p>
            </div>
          )}
          {dig.data.architecture && (
            <div class="dig-row">
              <div class="dig-label mono">03 · Structure<span class="pencil">Architecture</span></div>
              <div class="dig-body">
                <ol class="chain mono">
                  {dig.data.architecture.map((n) => (
                    <li class={`is-${n.kind}`}><span>{n.name}</span></li>
                  ))}
                </ol>
              </div>
            </div>
          )}
          {dig.data.dataModel && (
            <div class="dig-row hatch-earth">
              <div class="dig-label mono">04 · Foundations<span class="pencil">Data model</span></div>
              <p class="dig-body mono"><span style="color: var(--teal)">{dig.data.dataModel.join(" → ")}</span></p>
            </div>
          )}
          <div class="dig-row hatch-rock">
            <div class="dig-label mono">05 · Bedrock<span class="pencil">Outcomes</span></div>
            <p class="dig-body mono"><span>{dig.data.results ? dig.data.results[0] : "On the full sheet"}</span></p>
          </div>
        </div>
        <a class="out-link" href={`/projects/${dig.id}/`}>Open the Full Sheet <Icon name="right" /></a>
      </Level>
    )
  }

  <!-- B6 · Professional journey -->
  <Level floor={B6} title="Core sample" sub="The professional journey: four years of strata, newest at the drill head." band="ochre" tone="var(--h-olive)">
    <CoreSample />
  </Level>

  <!-- B7 · Philosophy -->
  <Level floor={B7} title="Foundations" sub="Engineering philosophy. <em>Three things I don’t compromise on.</em>" band="none" bedrock tone="var(--chalk)" numTone="var(--graphite)">
    <ol class="piles" role="list">
      {
        PRINCIPLES.map((p, i) => (
          <li class="pile">
            <span class="mono pencil">Pile {String(i + 1).padStart(2, "0")}</span>
            <h3 class="serif"><span class="reveal" style={`--fill: ${pileTones[i]}`}>{p.title}</span></h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="bedrock mono" aria-hidden="true"><span>Load-bearing · bedrock</span></div>
  </Level>

  <!-- B8 · Contact -->
  <Level floor={B8} title="Service elevator" sub="Contact: the way back up." band="rock" tone="var(--graphite)" numTone="var(--chalk)" class="lvl--last below-bedrock">
    <span class="response-line" aria-hidden="true"></span>
    <span class="response-shaft" aria-hidden="true"></span>
    <span class="response-label mono ico" aria-hidden="true">Response <Icon name="up" /></span>

    <div class="contact-wrap">
      <div class="contact-main">
        <p class="serif"><span class="reveal">You’ve seen what’s underneath.</span> <em class="reveal" style="--fill: var(--signal-text)">Let’s build something on top of it.</em></p>
        <div style="display: grid; gap: 12px">
          <span class="mono pencil">Fastest way to reach me</span>
          <a class="big-email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <div><CopyButton text={CONTACT.email} label="email address" /></div>
        </div>
        <ul class="links-grid links-grid--3" role="list">
          <li><a href={whatsapp} rel="noopener"><span class="mono">WhatsApp</span><span class="ico">{CONTACT.whatsapp.display} <Icon name="external" size={12} /></span></a></li>
          <li><a href={CONTACT.github} rel="me noopener"><span class="mono">GitHub</span><span class="ico" translate="no">{CONTACT.github.split("/").pop()} <Icon name="external" size={12} /></span></a></li>
          <li><a href={CONTACT.linkedin} rel="me noopener"><span class="mono">LinkedIn</span><span class="ico" translate="no">rokon-raz <Icon name="external" size={12} /></span></a></li>
          <li><a href={CONTACT.cv} download><span class="mono">CV</span><span class="ico">Download PDF <Icon name="download" size={12} /></span></a></li>
          <li><a href="/contact/"><span class="mono">More ways</span><span class="ico">Contact page <Icon name="right" size={12} /></span></a></li>
          <li><a href={`mailto:${CONTACT.email}?subject=${encodeURIComponent("Freelance project")}`}><span class="mono">Freelance</span><span class="ico">Start a project <Icon name="mail" size={12} /></span></a></li>
        </ul>
      </div>
      <Terminal />
    </div>

    <div class="shaft-foot mono">
      <a class="out-link out-link--solid" href={`#${L0.id}`} style="margin: 0">Return to Street Level <Icon name="up" /></a>
      <span class="ico"><Logo /> © {year} MD. Rokunuzzaman Rokon · Drawn in Dhaka</span>
      <VisitCount />
    </div>
  </Level>
</Base>

<script>
  /*
   * B2: the raw supplier lines drift around their box at random, all the time, one line at a
   * time: each picks a new spot and a slight tilt every few seconds, and never leaves the box.
   * It only rests while the tab is hidden, and picks up again when you come back.
   */
  const box = document.querySelector<HTMLElement>("[data-drift]");

  if (box) {
    const lines = [...box.querySelectorAll<HTMLElement>(".raw-line")];
    const timers = new Map<HTMLElement, number>();
    const pad = 10;
    let running = false;

    // Switch from the static percentage layout to transforms, nudging any line that pokes
    // out of the box back inside.
    for (const line of lines) {
      const x = Math.min(Math.max(pad, line.offsetLeft), Math.max(pad, box.clientWidth - line.offsetWidth - pad));
      const y = Math.min(Math.max(pad, line.offsetTop), Math.max(pad, box.clientHeight - line.offsetHeight - pad));
      line.style.left = "0";
      line.style.top = "0";
      line.style.translate = `${x}px ${y}px`;
    }
    // Only now turn the transitions on, so the lines don't glide in from the corner.
    void box.offsetWidth;
    lines.forEach((line) => line.classList.add("is-drifting"));

    const move = (line: HTMLElement) => {
      const maxX = Math.max(pad, box.clientWidth - line.offsetWidth - pad);
      const maxY = Math.max(pad, box.clientHeight - line.offsetHeight - pad);
      const x = pad + Math.random() * (maxX - pad);
      const y = pad + Math.random() * (maxY - pad);
      // Long lines tilt less, so their corners stay inside the box too.
      const maxTilt = Math.min(6, (Math.asin(Math.min(1, 14 / line.offsetWidth)) * 180) / Math.PI);
      const tilt = ((Math.random() * 2 - 1) * maxTilt).toFixed(1);
      const seconds = 2.5 + Math.random() * 3;
      line.style.setProperty("--drift", `${seconds}s`);
      line.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
      line.style.rotate = `${tilt}deg`;
      // The next move starts as this one ends, so the lines never stand still.
      timers.set(line, window.setTimeout(() => running && move(line), seconds * 1000));
    };

    const start = () => {
      if (running) return;
      running = true;
      lines.forEach((line, i) => timers.set(line, window.setTimeout(() => move(line), i * 120)));
    };
    const stop = () => {
      running = false;
      timers.forEach((t) => clearTimeout(t));
      timers.clear();
    };

    start();
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>

<script>
  /*
   * L0: the building's windows light up one at a time in a random colour, then go back to the
   * plain drawing, as if someone were working late on each floor. Rests only while the tab is hidden.
   */
  const building = document.querySelector<SVGElement>("[data-windows]");

  if (building) {
    const windows = [...building.querySelectorAll<SVGRectElement>(".win")];
    const colours = ["var(--signal)", "var(--teal)", "#ffd43b", "var(--h-mulberry)", "var(--h-indigo)", "var(--h-olive)", "var(--ochre)"];
    let last: SVGRectElement | undefined;
    let timer = 0;
    let running = false;

    const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];

    // One window at a time: light a random one (never the same twice in a row), hold it,
    // let it go dark, pause, then the next.
    const flash = () => {
      if (!running) return;
      const win = pick(windows.filter((w) => w !== last));
      last = win;
      win.style.fill = pick(colours);
      win.classList.add("is-lit");
      timer = window.setTimeout(() => {
        win.classList.remove("is-lit");
        win.style.fill = "";
        timer = window.setTimeout(flash, 250 + Math.random() * 350);
      }, 900 + Math.random() * 600);
    };

    const start = () => {
      if (running) return;
      running = true;
      flash();
    };
    const stop = () => {
      running = false;
      clearTimeout(timer);
      windows.forEach((w) => {
        w.classList.remove("is-lit");
        w.style.fill = "";
      });
    };

    start();
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>
