---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BLOG, SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** "article" for blog posts; enables the published-time tag. */
  type?: "website" | "article";
  publishedDate?: Date;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedDate,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title={BLOG.title} href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Social previews (LinkedIn, X, Slack, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content="en_US" />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary" />

    <!-- Apply a saved theme before first paint so the page never flashes the wrong colours. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
