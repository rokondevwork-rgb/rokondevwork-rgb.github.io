---
import "../styles/global.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Snake from "../components/Snake.astro";
import { BLOG, SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** "article" for blog posts; enables the published-time tag. */
  type?: "website" | "article";
  publishedDate?: Date;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /**
   * Content width: "narrow" reading column (default), "wide" grid, or "full" when the page
   * lays out its own full-bleed sections and containers.
   */
  width?: "narrow" | "wide" | "full";
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedDate,
  noindex = false,
  width = "narrow",
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const mainClass = {
  narrow: "container container--narrow page",
  wide: "container page",
  full: undefined,
}[width];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title={BLOG.title} href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Self-hosted fonts. Only the faces used above the fold are preloaded. -->
    <Font cssVariable="--font-display" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" />

    <!-- Social previews (LinkedIn, X, Slack, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content="en_US" />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary" />

    <!--
      Runs before first paint: marks JS as available (enables the mobile menu and filters) and
      applies the theme so the page never flashes the wrong colours. A saved choice wins;
      otherwise light only when the OS asks for it, else dark. Without JS the site is dark.
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        let theme = localStorage.getItem("theme");
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <Snake />
  </body>
</html>
