---
import "../styles/global.css";
import { Font } from "astro:assets";
import ElevatorPanel from "../components/ElevatorPanel.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Snake from "../components/Snake.astro";
import Terminal from "../components/Terminal.astro";
import { SITE } from "../consts";
import { floorForPath } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
  /** "article" for blog posts; enables the published-time tag. */
  type?: "website" | "article";
  publishedDate?: Date;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** The homepage draws its own levels; every other page is a "sheet" with a title strip. */
  home?: boolean;
  /** Sheet label in the strip, e.g. "Sheet V-01 · Excavation". */
  sheet?: string;
  /** Snap the scroll from floor to floor (pages built from floors: home, about). */
  snap?: boolean;
}

const { title, description = SITE.description, type = "website", publishedDate, noindex = false, home = false, sheet, snap = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const current = floorForPath(Astro.url.pathname);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class:list={{ snap }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#efebe3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />

    <!-- Self-hosted fonts. Only the faces used above the fold are preloaded. -->
    <Font cssVariable="--font-sign" preload />
    <Font cssVariable="--font-serif" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-body" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />

    <!-- Social previews (LinkedIn, X, Slack, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content="en_US" />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <!--
      Runs before first paint: marks JS as available (enables the keypad, filters and terminal)
      and applies the theme so the page never flashes the wrong colours. A saved choice wins;
      otherwise the OS setting: day (drafting sheet) when it asks for light, else night shift.
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        let theme = localStorage.getItem("theme");
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to Content</a>
    <div class="site">
      <div class="gauge" aria-hidden="true">
        <div class="gauge-read">
          <span class="mono">Depth</span>
          <span class="gauge-value" data-depth>{home ? "−00.0" : "—"}</span>
          <span class="mono">m</span>
        </div>
      </div>

      <ElevatorPanel current={current} home={home} />

      {
        !home && (
          <header class="sheet-strip mono">
            <a href="/" aria-label="Rokon, back to street level">
              <Logo />
              <span>{SITE.name}</span>
            </a>
            <span>{sheet ?? title}</span>
          </header>
        )
      }

      <main id="main">
        <slot />
      </main>

      {
        !home && (
          <footer class="sheet-nav mono">
            <a href="/">
              <Icon name="up" />
              Return to Street Level
            </a>
            <span>
              © {year} MD. Rokunuzzaman Rokon · Drawn in Dhaka
            </span>
          </footer>
        )
      }
    </div>

    <dialog class="intercom-dialog" data-intercom-dialog aria-label="Intercom terminal">
      <Terminal mode="dialog" />
    </dialog>
    <Snake />
  </body>
</html>
