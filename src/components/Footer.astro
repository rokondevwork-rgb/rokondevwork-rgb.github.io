---
import { CONTACT, SITE } from "../consts";
import { NAV_ITEMS } from "../lib/nav";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-intro">
        <p class="footer-name">{SITE.name}</p>
        <p>Python backend developer in Dhaka, Bangladesh. Open to backend roles and freelance work.</p>
      </div>

      <ul class="footer-links" aria-label="Site">
        {
          NAV_ITEMS.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>

      <ul class="footer-links" aria-label="Elsewhere">
        <li><a href={`mailto:${CONTACT.email}`}>Email</a></li>
        <li><a href={CONTACT.github} rel="me noopener">GitHub</a></li>
        <li><a href={CONTACT.linkedin} rel="me noopener">LinkedIn</a></li>
      </ul>
    </div>

    <p class="footer-base">&copy; {year} {SITE.name}.</p>
  </div>
</footer>
