---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  posts: CollectionEntry<"blog">[];
  /** Keeps the heading outline correct: 2 under a page h1, 3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article class="post-row">
          <time class="post-row-date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <div class="post-row-body">
            <Heading class="post-row-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && " (draft)"}
            </Heading>
            <p class="post-row-description">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tags" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    ))
  }
</ul>
