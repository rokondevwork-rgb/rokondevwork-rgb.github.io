---
/**
 * The intercom: a small terminal for visitors who like typing. Every command has a clickable
 * chip too, and the log already shows a short session, so nothing here needs a keyboard.
 * Commands: help, whoami, ls projects, open <project>, goto <floor>, stack --uses <tool>,
 * cat cv.pdf, contact --email|--whatsapp, theme day|night, snake on|off, clear.
 * ⌘K / Ctrl+K (or "/") jumps to the terminal on the page, or opens it in a dialog.
 */
import { CONTACT, SITE } from "../consts";
import { FLOORS, SHEETS } from "../lib/data";
import { getProjects } from "../lib/content";

interface Props {
  /** "inline" sits in the page; "dialog" lives in the ⌘K dialog in Base.astro. */
  mode?: "inline" | "dialog";
}

const { mode = "inline" } = Astro.props;
const projects = (await getProjects()).map((p) => ({ slug: p.id, title: p.data.title, stack: p.data.stack }));
const data = {
  name: SITE.name,
  email: CONTACT.email,
  whatsapp: `https://wa.me/${CONTACT.whatsapp.number}`,
  github: CONTACT.github,
  cv: CONTACT.cv,
  projects,
  floors: [...FLOORS.map((f) => ({ code: f.code, href: `/#${f.id}`, name: f.name })), ...SHEETS],
};
const id = `term-${mode}`;
---

<section class="terminal" data-terminal data-mode={mode} aria-label="Intercom terminal" data-info={JSON.stringify(data)}>
  <div class="terminal-head mono">
    <span>Intercom</span>
    <span class="pencil">⌘&nbsp;K anywhere</span>
  </div>
  <div class="terminal-log data" role="log" aria-live="polite" data-log>
    <p><span class="prompt">rokon@below-grade:~$</span> whoami</p>
    <p>MD. Rokonuzzaman Rokon · Python backend engineer</p>
    <p>Dhaka, Bangladesh (UTC+6) · open to roles + freelance</p>
    <p>&nbsp;</p>
    <p><span class="prompt">rokon@below-grade:~$</span> ls projects</p>
    <p class="out-teal">{projects.map((p) => p.slug).join("  ")}</p>
    <p>&nbsp;</p>
    <p class="pencil">Type <kbd>help</kbd>, or tap a command below.</p>
  </div>
  <form class="terminal-form data" data-form hidden>
    <label class="prompt" for={id}>rokon@below-grade:~$</label>
    <input id={id} name="command" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" placeholder="help…" />
  </form>
  <div class="terminal-chips mono" data-chips hidden>
    {["help", "whoami", "ls projects", "cat cv.pdf", "snake on", "theme day"].map((c) => <button type="button" data-run={c}>{c}</button>)}
  </div>
</section>

<script>
  type Info = {
    name: string;
    email: string;
    whatsapp: string;
    github: string;
    cv: string;
    projects: { slug: string; title: string; stack: string[] }[];
    floors: { code: string; href: string; name: string }[];
  };
  type Part = string | { text: string; href: string; download?: boolean };

  for (const term of document.querySelectorAll<HTMLElement>("[data-terminal]")) {
    const info: Info = JSON.parse(term.dataset.info ?? "{}");
    const log = term.querySelector<HTMLElement>("[data-log]")!;
    const form = term.querySelector<HTMLFormElement>("[data-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const chips = term.querySelector<HTMLElement>("[data-chips]")!;
    const history: string[] = [];
    let back = 0;
    form.hidden = false;
    chips.hidden = false;

    const line = (parts: Part[] | string, cls?: string) => {
      const p = document.createElement("p");
      if (cls) p.className = cls;
      for (const part of typeof parts === "string" ? [parts] : parts) {
        if (typeof part === "string") p.append(part);
        else {
          const a = document.createElement("a");
          a.href = part.href;
          a.textContent = part.text;
          if (part.download) a.setAttribute("download", "");
          p.append(a);
        }
      }
      log.append(p);
    };
    const echo = (cmd: string) => {
      const p = document.createElement("p");
      const s = document.createElement("span");
      s.className = "prompt";
      s.textContent = "rokon@below-grade:~$ ";
      p.append(s, cmd);
      log.append(p);
    };
    const go = (href: string) => setTimeout(() => (location.href = href), 450);

    const run = (raw: string) => {
      const cmd = raw.trim();
      if (!cmd) return;
      history.push(cmd);
      back = history.length;
      echo(cmd);
      const [word, ...rest] = cmd.split(/\s+/);
      const arg = rest.join(" ").toLowerCase();

      switch (word.toLowerCase()) {
        case "help":
          line("whoami · ls projects · open <project> · goto <floor>");
          line("stack --uses <tool> · cat cv.pdf · contact --email · contact --whatsapp");
          line("theme day|night · snake on|off · clear");
          break;
        case "whoami":
          line(`${info.name} · Python backend engineer, Dhaka (UTC+6)`);
          line("APIs, data pipelines and the databases underneath them.");
          break;
        case "ls":
          info.projects.forEach((p, i) => line([`V-${String(i + 1).padStart(2, "0")}  `, { text: p.slug, href: `/projects/${p.slug}/` }], "out-teal"));
          break;
        case "open": {
          const n = Number(arg.replace(/^v-?/, ""));
          const p = Number.isInteger(n) && n > 0 ? info.projects[n - 1] : info.projects.find((x) => x.slug === arg || x.title.toLowerCase() === arg);
          if (p) {
            line(`Opening ${p.title}…`);
            go(`/projects/${p.slug}/`);
          } else line("No such vault. Try 'ls projects'.");
          break;
        }
        case "goto":
        case "cd": {
          const f = info.floors.find((x) => x.code.toLowerCase() === arg || x.name.toLowerCase() === arg);
          if (f) {
            line(`Going to ${f.code} · ${f.name}…`);
            go(f.href);
          } else line("Floors: L0 to B8, FN (field notes), SR (site radio).");
          break;
        }
        case "stack": {
          const tool = arg.replace("--uses", "").trim();
          const hits = info.projects.filter((p) => p.stack.some((s) => s.toLowerCase() === tool));
          if (!tool) line("Usage: stack --uses fastapi");
          else if (hits.length) line(`${hits.length} ${hits.length === 1 ? "project" : "projects"}: ${hits.map((p) => p.title).join(", ")}`, "out-teal");
          else line(`No project lists ${tool} yet.`);
          break;
        }
        case "cat":
          if (arg.startsWith("cv")) line(["CV ready: ", { text: "download the PDF", href: info.cv, download: true }]);
          else line("Try 'cat cv.pdf'.");
          break;
        case "contact":
          if (arg.includes("whatsapp")) line(["WhatsApp: ", { text: "open a chat", href: info.whatsapp }]);
          else line(["Email: ", { text: info.email, href: `mailto:${info.email}` }]);
          break;
        case "theme": {
          const want = arg === "day" || arg === "light" ? "light" : arg === "night" || arg === "dark" ? "dark" : "";
          const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
          if (!want) line("Usage: theme day | theme night");
          else {
            if ((document.documentElement.dataset.theme === "light") !== (want === "light")) toggle?.click();
            line(want === "light" ? "Drafting sheet: day." : "Night shift: dark.");
          }
          break;
        }
        case "snake":
        case "python": {
          const toggle = document.querySelector<HTMLButtonElement>("#snake-toggle");
          if (!toggle || toggle.hidden) line("The python only comes out where there's a mouse to chase.");
          else {
            const on = toggle.getAttribute("aria-pressed") === "true";
            const want = arg === "off" ? false : arg === "on" ? true : !on;
            if (want !== on) toggle.click();
            line(want ? "Hiss. The python is out: move your mouse." : "The python is curled up in its basket.");
          }
          break;
        }
        case "clear":
          log.replaceChildren();
          break;
        case "sudo":
          line("Nice try. Email me instead.");
          break;
        default:
          line(`Command not found: ${word}. Try 'help', or just email me.`);
      }
      log.scrollTop = log.scrollHeight;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      run(input.value);
      input.value = "";
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowUp" && back > 0) {
        back--;
        input.value = history[back];
        event.preventDefault();
      } else if (event.key === "ArrowDown" && back < history.length) {
        back++;
        input.value = history[back] ?? "";
        event.preventDefault();
      }
    });
    chips.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-run]");
      if (button) run(button.dataset.run ?? "");
    });
  }

  // ⌘K / Ctrl+K / "/": the terminal on the page if there is one, else the dialog.
  const dialog = document.querySelector<HTMLDialogElement>("[data-intercom-dialog]");
  const open = () => {
    const inline = document.querySelector<HTMLElement>('[data-terminal][data-mode="inline"]');
    if (inline) {
      inline.scrollIntoView({ block: "center" });
      inline.querySelector("input")?.focus({ preventScroll: true });
    } else if (dialog) {
      dialog.showModal();
      dialog.querySelector("input")?.focus();
    }
  };
  addEventListener("keydown", (event) => {
    const typing = (event.target as HTMLElement).closest("input, textarea, [contenteditable]");
    if ((event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) || (event.key === "/" && !typing)) {
      event.preventDefault();
      open();
    }
  });
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-open-intercom]")) open();
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
