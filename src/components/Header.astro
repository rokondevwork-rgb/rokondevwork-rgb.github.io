---
import { SITE } from "../consts";
import { NAV_ITEMS } from "../lib/nav";

const path = Astro.url.pathname;

// "page" marks the exact current page; "true" marks the section a nested page belongs to.
function currentState(href: string) {
  if (path === href) return "page";
  if (path.startsWith(href)) return "true";
  return undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>{SITE.name}</a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {
          NAV_ITEMS.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={currentState(href)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <!--
        The buttons stay hidden until a script reveals them: the snake button by Snake.astro (mouse
        devices only), the others by the script below. Without JS: dark theme, nav always visible.
      -->
      <button type="button" class="icon-button snake-toggle" id="snake-toggle" aria-pressed="true" hidden>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M1.75 8.5c1.6-3 3.4-3 5 0s3.4 3 5 0"></path>
          <circle cx="12.75" cy="6.5" r="1.75" fill="currentColor" stroke="none"></circle>
          <path class="snake-toggle-off" d="M2.5 2.5l11 11"></path>
        </svg>
        <span class="visually-hidden">Snake that follows the mouse</span>
      </button>

      <button type="button" class="icon-button theme-toggle" id="theme-toggle" aria-pressed="true" hidden>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor"></circle>
          <path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor"></path>
        </svg>
        <span class="visually-hidden">Dark theme</span>
      </button>

      <button type="button" class="icon-button nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" hidden>
        <svg class="icon-menu" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;

  // Theme: applied in <head> before paint (saved choice, else OS light, else dark).
  const themeButton = document.querySelector<HTMLButtonElement>("#theme-toggle");
  if (themeButton) {
    const isDark = () => root.dataset.theme !== "light";
    const sync = () => themeButton.setAttribute("aria-pressed", String(isDark()));

    themeButton.hidden = false;
    sync();
    themeButton.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage blocked (e.g. private mode): the choice lasts for this page only.
      }
      sync();
    });
  }

  // Mobile menu: a disclosure button that shows/hides the nav on small screens.
  const menuButton = document.querySelector<HTMLButtonElement>("#nav-toggle");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  if (menuButton && nav) {
    const isOpen = () => menuButton.getAttribute("aria-expanded") === "true";
    const setOpen = (open: boolean) => {
      menuButton.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
    };

    menuButton.hidden = false;
    menuButton.addEventListener("click", () => {
      setOpen(!isOpen());
      if (isOpen()) nav.querySelector("a")?.focus();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        menuButton.focus();
      }
    });
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (isOpen() && !nav.contains(target) && !menuButton.contains(target)) setOpen(false);
    });
  }
</script>
