---
/**
 * Line icons drawn in the same 1.5px stroke as the rest of the drawing. Decorative: always
 * place them beside visible text, or give the control its own label.
 */
interface Props {
  name: "down" | "up" | "right" | "left" | "external" | "download" | "close" | "terminal" | "theme" | "mail";
  size?: number;
}

const { name, size = 14 } = Astro.props;

const paths: Record<Props["name"], string> = {
  down: "M8 2v12M3 9l5 5 5-5",
  up: "M8 14V2M3 7l5-5 5 5",
  right: "M2 8h12M9 3l5 5-5 5",
  left: "M14 8H2M7 3L2 8l5 5",
  external: "M5 3h8v8M13 3L3 13",
  download: "M8 2v9M4 7l4 4 4-4M2 14h12",
  close: "M3 3l10 10M13 3L3 13",
  terminal: "M2 4l4 4-4 4M8 12h6",
  theme: "M8 1.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13M8 1.5v13",
  mail: "M1.5 3.5h13v9h-13zM1.5 3.5L8 9l6.5-5.5",
};
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  focusable="false"
>
  <path d={paths[name]}></path>
  {name === "theme" && <path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor" stroke="none"></path>}
</svg>
