---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Keeps the heading outline correct: 2 under a page h1, 3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const { title, summary, stack } = project.data;
const Heading = `h${headingLevel}` as const;
---

<article class="project-card">
  <Heading><a href={`/projects/${project.id}/`}>{title}</a></Heading>
  <p>{summary}</p>
  <ul class="stack" aria-label="Tech stack">
    {stack.map((tech) => <li>{tech}</li>)}
  </ul>
</article>
